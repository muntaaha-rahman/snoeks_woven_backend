# Database. Defaults to a local SQLite file if unset.
# For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/snoeks_woven
DATABASE_URL=sqlite:///./snoeks.db

# SMTP settings used to auto-send the PDF report after every save.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@snoekswonen.nl
EMAIL_TO=info@snoekswonen.nl

# Company name shown on the PDF report header.
COMPANY_NAME=Snoeks Wonen

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173
